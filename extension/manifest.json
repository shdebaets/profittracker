{
  "manifest_version": 3,
  "name": "FlipLedger Lister",
  "version": "0.8.0",
  "description": "Fills in your Facebook Marketplace, Poshmark and Mercari listings from FlipLedger, keeps your cross-listings in sync, and reads eBay sold prices for your comps.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://poshmark.com/*",
    "https://www.mercari.com/*",
    "https://www.ebay.com/*",
    "https://*.supabase.co/*",
    "http://127.0.0.1:54321/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://profit.emoneydeals.com/*",
        "https://profittracker-iye3.vercel.app/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "shared.js",
        "content-app.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.facebook.com/marketplace/*"
      ],
      "js": [
        "shared.js",
        "dom.js",
        "site-facebook.js",
        "runner.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://poshmark.com/*"
      ],
      "js": [
        "shared.js",
        "dom.js",
        "site-poshmark.js",
        "runner.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.mercari.com/*"
      ],
      "js": [
        "shared.js",
        "dom.js",
        "site-mercari.js",
        "runner.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ebay.com/sch/*"
      ],
      "js": [
        "comps-ebay.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
