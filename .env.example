# Supabase project (Vercel Marketplace Supabase integration sets these automatically)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local-only test accounts used for manual QA against `supabase start` (never use in production)
# TEST_USER_A=qa-a@flipledger.test / flip-qa-8842
# TEST_USER_B=qa-b@flipledger.test / flip-qa-8842

# Server-only. Needed for eBay token storage, sale sync cron and webhooks.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; encrypts marketplace OAuth tokens at rest.
TOKEN_ENCRYPTION_KEY=
# Vercel Cron sends this as a bearer token to /api/cron/sync-sales.
CRON_SECRET=
# Production only: redirect *.vercel.app to this host (no scheme). Set once its DNS works.
CANONICAL_HOST=

# eBay developer app (developer.ebay.com). Use the Sandbox keyset until production keys are approved.
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName (eBay "redirect URL name"); its accept URL must be https://<app>/api/marketplaces/ebay/callback
EBAY_RUNAME=
# Marketplace account deletion: the token you enter on eBay, and the exact endpoint URL registered there.
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=https://<app>/api/marketplaces/ebay/account-deletion

# Research (eBay price research). Needs production eBay keys above, plus Claude for matching.
ANTHROPIC_API_KEY=
# Optional: daily eBay Browse calls shared by all users (eBay's default app limit is 5000).
# RESEARCH_EBAY_DAILY_BUDGET=5000
# Optional model overrides (defaults: claude-sonnet-5-5 to identify products, claude-haiku-5-5 to judge listings).
# RESEARCH_ID_MODEL=
# RESEARCH_JUDGE_MODEL=
