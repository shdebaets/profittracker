# Supabase project (Vercel Marketplace Supabase integration sets these automatically)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local-only test accounts used for manual QA against `supabase start` (never use in production)
# TEST_USER_A=qa-a@flipledger.test / flip-qa-8842
# TEST_USER_B=qa-b@flipledger.test / flip-qa-8842

# Server-only. Needed for eBay token storage, sale sync cron and webhooks.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; encrypts marketplace OAuth tokens at rest.
TOKEN_ENCRYPTION_KEY=
# Vercel Cron sends this as a bearer token to /api/cron/sync-sales.
CRON_SECRET=
# Production only: redirect *.vercel.app to this host (no scheme). Set once its DNS works.
CANONICAL_HOST=

# eBay developer app (developer.ebay.com). Use the Sandbox keyset until production keys are approved.
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName (eBay "redirect URL name"); its accept URL must be https://<app>/api/marketplaces/ebay/callback
EBAY_RUNAME=
# Marketplace account deletion: the token you enter on eBay, and the exact endpoint URL registered there.
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=https://<app>/api/marketplaces/ebay/account-deletion

# Sign in with Whop + the paid Cross-Lister (lib/whop). The profit tracker is free for everyone.
# Leave WHOP_CLIENT_ID empty to keep email login.
# OAuth app id from whop.com/dashboard/developer; redirect URI https://<app>/auth/whop/callback
WHOP_CLIENT_ID=
# Account API key used to check memberships (users.checkAccess).
WHOP_API_KEY=
# Comma-separated product ids that unlock cross-listing. Empty = cross-listing open to everyone.
# Production: prod_N6zbl5IfKlk7g (set it only once WHOP_CLIENT_ID is set, or nobody can unlock it).
WHOP_CROSSLIST_PRODUCT_IDS=
# Where "Get the Cross-Lister" goes (the product's Whop checkout link).
WHOP_CROSSLIST_CHECKOUT_URL=
# Comma-separated emails that always get the Cross-Lister (owner, testers, comps).
FLIPLEDGER_FREE_EMAILS=
# 1 = show the email/password and magic-link form too. Local QA only; never set in production.
ALLOW_EMAIL_LOGIN=1
